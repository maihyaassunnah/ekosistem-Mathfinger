FROM node:22-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy only what's needed for Prisma Studio
COPY package.json package-lock.json ./
COPY prisma ./prisma/

# Install all dependencies (including devDeps for prisma CLI)
RUN npm ci

# Generate Prisma Client
RUN npx prisma generate

EXPOSE 5555

# Run Prisma Studio listening on all interfaces
CMD ["npx", "prisma", "studio", "--hostname", "0.0.0.0", "--port", "5555", "--browser", "none"]
