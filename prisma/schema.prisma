// Prisma Schema for Les Mathfingers Management System
// Multi-Branch Architecture with PostgreSQL
// Complete Schema covering all Core Menus and Website CMS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  TUTOR
}

enum CommonStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum InvoiceType {
  SPP
  BOOK
  REGISTRATION
}

enum InvoiceStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  MANUAL_CASH
  MANUAL_TRANSFER
  GATEWAY
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

// ----------------------------------------------------
// A. CORE & OPERATIONAL MODELS
// ----------------------------------------------------

model Branch {
  id          String       @id @default(uuid())
  branchCode  String       @unique @map("branch_code")
  branchName  String       @map("branch_name")
  address     String       @db.Text
  phone       String?
  status      CommonStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  users           User[]
  students        Student[]
  classes         Class[]
  invoices        Invoice[]
  attendances     Attendance[]
  teacherJournals TeacherJournal[]
  grades          StudentGrade[]
  behaviors       StudentBehavior[]
  transactions    CashTransaction[]

  @@map("branches")
}

model User {
  id           String       @id @default(uuid())
  branchId     String?      @map("branch_id")
  fullName     String       @map("full_name")
  email        String       @unique
  passwordHash String       @map("password_hash")
  phone        String?
  avatarUrl    String?      @map("avatar_url")
  role         Role         @default(TUTOR)
  status       CommonStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  attendances     Attendance[]     @relation("TutorAttendances")
  teacherJournals TeacherJournal[] @relation("TutorJournals")

  @@map("users")
}

model Level {
  id                String    @id @default(uuid())
  levelName         String    @map("level_name")
  shortDesc         String?   @map("short_desc") @db.Text
  targetAge         String?   @map("target_age")
  description       String?   @db.Text
  learningGoals     String?   @map("learning_goals") @db.Text
  competencies      String?   @db.Text
  learningMaterials String?   @map("learning_materials") @db.Text
  indicators        String?   @db.Text
  orderIndex        Int       @default(1) @map("order_index")
  bookPrice         Decimal   @default(0) @db.Decimal(12, 2) @map("book_price")
  defaultSppPrice   Decimal   @default(0) @db.Decimal(12, 2) @map("default_spp_price")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  students Student[]

  @@map("levels")
}

model Student {
  id             String        @id @default(uuid())
  branchId       String        @map("branch_id")
  studentCode    String        @unique @map("student_code")
  qrIdentifier   String        @unique @map("qr_identifier")
  studentName    String        @map("student_name")
  gender         String?       @default("P")
  birthPlace     String?       @map("birth_place")
  birthDate      String?       @map("birth_date")
  address        String?       @db.Text
  schoolOrigin   String?       @map("school_origin")
  gradeLevel     String?       @map("grade_level")
  className      String?       @map("class_name")
  parentName     String        @map("parent_name")
  parentWhatsapp String        @map("parent_whatsapp")
  currentLevelId String        @map("current_level_id")
  status         StudentStatus @default(ACTIVE)
  registeredDate DateTime?     @default(now()) @map("registered_date")
  graduatedDate  DateTime?     @map("graduated_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentLevel    Level             @relation(fields: [currentLevelId], references: [id])
  invoices        Invoice[]
  attendances     Attendance[]
  grades          StudentGrade[]
  behaviors       StudentBehavior[]
  teacherJournals TeacherJournal[]

  @@map("students")
}

model Class {
  id            String       @id @default(uuid())
  branchId      String       @map("branch_id")
  className     String       @map("class_name")
  days          String
  time          String
  room          String?
  teacherName   String?      @map("teacher_name")
  levelName     String?      @map("level_name")
  enrolledCount Int          @default(0) @map("enrolled_count")
  maxCapacity   Int          @default(15) @map("max_capacity")
  status        CommonStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("classes")
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  branchId       String           @map("branch_id")
  tutorId        String           @map("tutor_id")
  attendanceDate DateTime         @map("attendance_date")
  method         AttendanceMethod @default(MANUAL)
  status         AttendanceStatus @default(HADIR)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tutor   User    @relation("TutorAttendances", fields: [tutorId], references: [id])

  @@unique([studentId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@map("attendances")
}

model TeacherJournal {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  studentId   String?  @map("student_id")
  tutorId     String?  @map("tutor_id")
  studentName String?  @map("student_name")
  className   String?  @map("class_name")
  teacherName String   @map("teacher_name")
  topic       String
  content     String   @db.Text
  journalDate DateTime @map("journal_date")
  refCode     String   @map("ref_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  tutor   User?    @relation("TutorJournals", fields: [tutorId], references: [id], onDelete: SetNull)

  @@map("teacher_journals")
}

model StudentGrade {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  branchId  String   @map("branch_id")
  className String?  @map("class_name")
  topic     String
  examDate  DateTime @map("exam_date")
  score     Decimal  @default(0) @db.Decimal(5, 2)
  isJoined  Boolean  @default(true) @map("is_joined")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("student_grades")
}

model StudentBehavior {
  id            String   @id @default(uuid())
  studentId     String   @map("student_id")
  branchId      String   @map("branch_id")
  behaviorDate  DateTime @map("behavior_date")
  sessionTopic  String   @map("session_topic")
  focus         String   @default("Sangat Baik")
  participation String   @default("Sangat Aktif")
  attitude      String   @default("Sopan & Tertib")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("student_behaviors")
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique @map("invoice_number")
  studentId       String         @map("student_id")
  branchId        String         @map("branch_id")
  type            InvoiceType    @default(SPP)
  period          String?
  amount          Decimal        @db.Decimal(12, 2)
  dueDate         DateTime       @map("due_date")
  status          InvoiceStatus  @default(UNPAID)
  paymentMethod   PaymentMethod? @map("payment_method")
  paidMethod      String?        @map("paid_method")
  paymentProofUrl String?        @map("payment_proof_url")
  gatewayRef      String?        @map("gateway_ref")
  paidAt          DateTime?      @map("paid_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mutations CashMutation[]

  @@index([branchId, status])
  @@map("invoices")
}

model CashMutation {
  id           String   @id @default(uuid())
  invoiceId    String?  @map("invoice_id")
  studentName  String?  @map("student_name")
  period       String?
  method       String   @default("TUNAI")
  description  String   @db.Text
  amount       Decimal  @db.Decimal(12, 2)
  mutationDate DateTime @map("mutation_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("cash_mutations")
}

model CashTransaction {
  id                String   @id @default(uuid())
  branchId          String   @map("branch_id")
  type              String   @default("INCOME")
  category          String   @default("SPP")
  title             String
  amount            Decimal  @db.Decimal(12, 2)
  sourceOrRecipient String   @map("source_or_recipient")
  transactionDate   DateTime @map("transaction_date")
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("cash_transactions")
}

// ----------------------------------------------------
// B. WEBSITE CMS MODELS
// ----------------------------------------------------

model WebsiteHero {
  id               String   @id @default(uuid())
  tagline          String
  headline         String
  subheadline      String   @db.Text
  promoBanner      String?  @map("promo_banner") @db.Text
  promoActive      Boolean  @default(true) @map("promo_active")
  whatsappNumber   String   @map("whatsapp_number")
  whatsappGreeting String   @map("whatsapp_greeting") @db.Text
  targetDiscount   String?  @map("target_discount")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("website_hero")
}

model WebsiteProgram {
  id              String   @id @default(uuid())
  levelTitle      String   @map("level_title")
  targetAge       String   @map("target_age")
  description     String   @db.Text
  monthlyFee      Decimal  @default(0) @db.Decimal(12, 2) @map("monthly_fee")
  registrationFee Decimal  @default(0) @db.Decimal(12, 2) @map("registration_fee")
  benefits        String   @db.Text
  popular         Boolean  @default(false)
  orderIndex      Int      @default(1) @map("order_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("website_programs")
}

model WebsiteTestimonial {
  id          String   @id @default(uuid())
  parentName  String   @map("parent_name")
  studentName String   @map("student_name")
  branch      String
  rating      Int      @default(5)
  comment     String   @db.Text
  avatarUrl   String?  @map("avatar_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("website_testimonials")
}

model WebsitePartner {
  id         String   @id @default(uuid())
  name       String
  category   String
  logoText   String   @map("logo_text")
  logoUrl    String?  @map("logo_url")
  website    String?
  isActive   Boolean  @default(true) @map("is_active")
  orderIndex Int      @default(1) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("website_partners")
}

model WebsiteLead {
  id          String   @id @default(uuid())
  studentName String   @map("student_name")
  studentAge  String   @map("student_age")
  parentName  String   @map("parent_name")
  phone       String
  branch      String
  status      String   @default("Baru")
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("website_leads")
}
